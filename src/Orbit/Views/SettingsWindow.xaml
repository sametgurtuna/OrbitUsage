<Window x:Class="Orbit.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit - Settings"
        Width="440" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">

        <TextBlock Text="Services" FontWeight="SemiBold" Margin="0,0,0,6" />

        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,4">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <CheckBox x:Name="ClaudeEnabledCheck" Content="Claude - enabled" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button x:Name="ClaudeLoginButton" Content="Log into Claude..." DockPanel.Dock="Right"
                            Click="ClaudeLoginButton_Click" Padding="6,2" HorizontalAlignment="Right" />
                </DockPanel>
                <CheckBox x:Name="ClaudeManualModeCheck" Content="Manual mode (skip scraping, use value below)" Margin="0,2" />
                <DockPanel Margin="0,2,0,0">
                    <TextBlock Text="Manual %:" VerticalAlignment="Center" Width="70" />
                    <TextBox x:Name="ClaudeManualPercentBox" Width="60" />
                    <Slider x:Name="ClaudeManualPercentSlider" Minimum="0" Maximum="100"
                            Margin="8,0,0,0" ValueChanged="ClaudeManualPercentSlider_ValueChanged" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Notify alerts:" Width="75" VerticalAlignment="Center" Foreground="#666" FontSize="11" />
                    <CheckBox x:Name="ClaudeNotify80Check" Content="80%" Margin="0,0,12,0" FontSize="11" />
                    <CheckBox x:Name="ClaudeNotify95Check" Content="95%" Margin="0,0,12,0" FontSize="11" />
                    <CheckBox x:Name="ClaudeNotify100Check" Content="100%" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,4" Opacity="0.6">
            <StackPanel>
                <CheckBox x:Name="ChatGptEnabledCheck" Content="ChatGPT - not implemented yet" IsEnabled="False" />
            </StackPanel>
        </Border>

        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <CheckBox x:Name="AntigravityEnabledCheck" Content="Antigravity - enabled" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button x:Name="AntigravityDetectButton" Content="Detect Antigravity..." DockPanel.Dock="Right"
                            Click="AntigravityDetectButton_Click" Padding="6,2" HorizontalAlignment="Right" />
                </DockPanel>
                <CheckBox x:Name="AntigravityManualModeCheck" Content="Manual mode (skip scraping, use value below)" Margin="0,2" />
                <DockPanel Margin="0,2,0,0">
                    <TextBlock Text="Manual %:" VerticalAlignment="Center" Width="70" />
                    <TextBox x:Name="AntigravityManualPercentBox" Width="60" />
                    <Slider x:Name="AntigravityManualPercentSlider" Minimum="0" Maximum="100"
                            Margin="8,0,0,0" ValueChanged="AntigravityManualPercentSlider_ValueChanged" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Notify alerts:" Width="75" VerticalAlignment="Center" Foreground="#666" FontSize="11" />
                    <CheckBox x:Name="AntigravityNotify80Check" Content="80%" Margin="0,0,12,0" FontSize="11" />
                    <CheckBox x:Name="AntigravityNotify95Check" Content="95%" Margin="0,0,12,0" FontSize="11" />
                    <CheckBox x:Name="AntigravityNotify100Check" Content="100%" FontSize="11" />
                </StackPanel>
                <TextBlock Text="Antigravity is a desktop app, not a web page - Orbit reads it via Chrome DevTools Protocol, which needs Antigravity running with --remote-debugging-port=9222 AND its Settings &gt; Models screen open (that's where the quota number lives; Orbit can't open it for you). Click Detect to check the connection. See selectors.json's Antigravity notes for the confirmed selector." Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#888" FontSize="10" />
            </StackPanel>
        </Border>

        <TextBlock Text="Refresh interval (minutes)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,14">
            <TextBox x:Name="IntervalBox" Width="50" DockPanel.Dock="Left" />
            <TextBlock Text="minutes (5-120)" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#888" />
        </DockPanel>

        <TextBlock Text="Display Monitor" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="MonitorComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceName"
                  SelectionChanged="MonitorComboBox_SelectionChanged" Margin="0,0,0,14" />

        <TextBlock Text="Layout" FontWeight="SemiBold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="LayoutTopCenterRadio" Content="Top center (horizontal)" GroupName="Layout" Margin="0,0,18,0" Checked="LayoutRadio_Checked" />
            <RadioButton x:Name="LayoutRightCenterRadio" Content="Right center (vertical)" GroupName="Layout" Checked="LayoutRadio_Checked" />
        </StackPanel>

        <TextBlock Text="Position offset (pixels)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Horizontal (X):" VerticalAlignment="Center" Width="90" />
            <TextBox x:Name="OffsetXBox" Width="50" DockPanel.Dock="Left" TextAlignment="Right" TextChanged="OffsetXBox_TextChanged" />
            <Slider x:Name="OffsetXSlider" Minimum="-100" Maximum="100"
                    Margin="8,0,0,0" ValueChanged="OffsetXSlider_ValueChanged" />
        </DockPanel>
        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Vertical (Y):" VerticalAlignment="Center" Width="90" />
            <TextBox x:Name="OffsetYBox" Width="50" DockPanel.Dock="Left" TextAlignment="Right" TextChanged="OffsetYBox_TextChanged" />
            <Slider x:Name="OffsetYSlider" Minimum="-100" Maximum="100"
                    Margin="8,0,0,0" ValueChanged="OffsetYSlider_ValueChanged" />
        </DockPanel>
        <TextBlock Text="Positive X moves right, positive Y moves down. Use this to nudge the notch flush against the screen edge." Margin="0,0,0,14" TextWrapping="Wrap" Foreground="#888" FontSize="11" />

        <TextBlock Text="Animation speed" FontWeight="SemiBold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton x:Name="AnimSpeedFastRadio" Content="Fast" GroupName="AnimSpeed" Margin="0,0,18,0" Checked="AnimSpeedRadio_Checked" />
            <RadioButton x:Name="AnimSpeedNormalRadio" Content="Normal" GroupName="AnimSpeed" Margin="0,0,18,0" Checked="AnimSpeedRadio_Checked" />
            <RadioButton x:Name="AnimSpeedFluidRadio" Content="Fluid" GroupName="AnimSpeed" Checked="AnimSpeedRadio_Checked" />
        </StackPanel>
        <TextBlock Text="How quickly the notch grows/shrinks on hover - Fast is snappiest, Fluid is the slowest and smoothest." Margin="0,0,0,14" TextWrapping="Wrap" Foreground="#888" FontSize="11" />

        <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Margin="0,0,0,14" />

        <Button x:Name="ReloadSelectorsButton" Content="Reload selectors.json"
                Click="ReloadSelectorsButton_Click" HorizontalAlignment="Left" Padding="6,3" Margin="0,0,0,14" />

        <TextBlock x:Name="StatusText" Foreground="#888" Margin="0,0,0,10" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Save" Width="80" Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
